# このファイルをコピーして .env を作り、値を入れる（.env は Git に入れない）
# cp .env.example .env

# セッションの暗号化に使う長いランダムな文字列
# 作り方: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 本番（MySQL）: ユーザー名・パスワードは .env にだけ本物を書く
DATABASE_URL=mysql+pymysql://ユーザー名:パスワード@localhost/sinden?charset=utf8mb4
# 開発（SQLite）の場合: sqlite:///sinden.sqlite

# Claude API（空なら女神の鏡は「いまは使えません」になる）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Stripe（テストモードのキー sk_test_... と whsec_...）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 本番（https）では 1 にする1
# PRICE_MIRROR_PACK=100
